	(text "QN88 package is common between N4, N9, NR4 and NR9.\nN2 also supports this package, but very different pinout\n\nCarried by RuTronic, Mouser and these guys:\nhttps://www.edgeelectronics.com/fpga/?start=49\n"
		(exclude_from_sim no)
		(at 96.52 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "869655e8-1e16-4b93-a472-95d98eb71b76")
	)
	(text "Fixed"
